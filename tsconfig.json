{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "esnext"],
    "strict": true,
    "jsx": "react-jsx",
    "declaration": false,
    "importHelpers": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noUnusedParameters": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["libs/shared"],
      "@shared/*": ["libs/shared/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["apps", "libs", "index.html"],
  "exclude": ["node_modules", "dist", "**/*.js"]
}
