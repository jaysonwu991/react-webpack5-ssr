{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "webapp",
  "projectType": "application",
  "sourceRoot": "apps/webapp",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist"],
      "options": {
        "command": "vite build && vite build --ssr apps/webapp/render.tsx --outDir dist/server"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/webapp --ext .ts,.tsx"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/webapp --ext .ts,.tsx --fix"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit"
      }
    }
  }
}
