{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "server",
  "projectType": "application",
  "root": "apps/server",
  "sourceRoot": "apps/server/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_ENV=development tsx watch apps/server/src/server.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_ENV=production tsx apps/server/src/server.ts"
      }
    }
  },
  "tags": []
}
