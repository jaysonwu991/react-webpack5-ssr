{
  "name": "react-webpack5-ssr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server/server.ts",
    "build": "rm -rf dist && vite build && vite build --ssr src/server/ssr/createRenderContext.tsx --outDir dist/server",
    "preview": "NODE_ENV=production tsx src/server/server.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialize-javascript": "^6.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/serialize-javascript": "^5.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.80.5",
    "tsx": "^4.19.1",
    "typescript": "^5.9.2",
    "vite": "^5.4.10"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
