{
  "name": "falcon-ssr-demo",
  "version": "0.1.0",
  "description": "A server-side rendered React application with Falcon-inspired architecture using Nx monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "npx nx dev server",
    "build": "npx nx run-many -t build --all",
    "lint": "npx nx run-many -t lint --all",
    "lint:fix": "npx nx run-many -t lint:fix --all",
    "lint:css": "stylelint \"**/*.{css,scss}\" --cache",
    "lint:css:fix": "stylelint \"**/*.{css,scss}\" --fix --cache",
    "typecheck": "npx nx run-many -t typecheck --all",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@loadable/component": "^5.16.7",
    "@loadable/server": "^5.16.7",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serialize-javascript": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.3",
    "@eslint/js": "^9.39.2",
    "@loadable/babel-plugin": "^5.16.1",
    "@loadable/webpack-plugin": "^5.15.2",
    "@nx/eslint": "^22.3.3",
    "@nx/webpack": "^22.3.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/loadable__component": "^5.13.10",
    "@types/loadable__server": "^5.12.11",
    "@types/loadable__webpack-plugin": "^5.15.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/serialize-javascript": "^5.0.4",
    "@types/webpack": "^5.28.5",
    "@types/webpack-env": "^1.18.8",
    "@types/webpack-hot-middleware": "^2.25.12",
    "@types/webpack-node-externals": "^3.0.4",
    "autoprefixer": "^10.4.23",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "mini-css-extract-plugin": "^2.9.4",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "null-loader": "^4.0.1",
    "nx": "^22.3.3",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.5.0",
    "sass-embedded": "^1.97.1",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-dev-server": "^5.2.2",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-node-externals": "^3.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
